# ローカル実行用。実値は .env に置く（gitignore 済み）。
# 本番は GitHub Secrets に登録する。このリポジトリは public なのでログに出さないこと。

# Supabase
# secret key（sb_secret_...）。Settings > API Keys から取得する。
# service_role ロールで動くので RLS をバイパスする。絶対にフロントへ置かない
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Garmin（通常運用では DB のトークンを使う。ここはトークン失効時の再ログイン用）
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Google カレンダーの「非公開 URL（iCal 形式）」。実質的な認証情報
GOOGLE_CALENDAR_ICS_URL=

# Web Push（VAPID）
# VAPID_SUBJECT は mailto:... または https://... でないと Apple は 403 を返す
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# バッチ失敗通知
DISCORD_WEBHOOK_URL=
