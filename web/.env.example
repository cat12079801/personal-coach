# ローカル実行用。実値は .env.local に置く（gitignore 済み）。
# Cloudflare Pages ではビルド環境変数に設定する。
#
# publishable key（sb_publishable_...）はフロントに埋め込まれる公開値であり、秘密ではない。
# データを守っているのは Supabase 側の RLS（is_owner()）だけである。
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push の公開鍵。秘密鍵はバッチ側（GitHub Secrets）に置く
VITE_VAPID_PUBLIC_KEY=

# デザイン検証モード。1 だとログイン不要・DB 非接続のダミーデータ表示になる。
# `npm run dev:design` が立てるので通常はここに書かなくてよい。
# **Cloudflare Pages のビルド環境変数には絶対に入れない**（理由は src/lib/design.ts）
# VITE_DESIGN_MODE=1
